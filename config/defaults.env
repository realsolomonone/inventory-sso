# Shared defaults. Scripts source this first, then config/envs/${ENVIRONMENT}.env.
# Copy an env file and change ROLE_NAME / AWS_REGION / PROJECT to reuse this repo
# for another project or partition (see config/envs/commercial.example.env).

PROJECT=inventory-sso
ENVIRONMENT=gov-east
ROLE_NAME=r-edl-resource-inventory
ROLE_DESCRIPTION="Read-only Resource Groups and Resource Groups Tagging API access for EDL inventory"
AWS_REGION=us-gov-east-1
AWS_PARTITION=aws-us-gov
PURPOSE=edl-resource-inventory
PROJECT_NAME_TAG=edl_resource_inventory
RESOURCE_GROUP_ACCOUNT_ID=
TRUSTED_PRINCIPAL_ARNS=
TRUSTED_SOURCE_ACCOUNT_IDS=

# Optional: only SSO profiles whose name starts with this prefix.
PROFILE_PREFIX=
# Optional: only profiles using this Identity Center start URL.
SSO_START_URL=
# Comma-separated profile names to skip.
EXCLUDE_PROFILES=
