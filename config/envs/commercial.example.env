# Example: reuse this repo for commercial AWS (copy to commercial.env and edit).
#   cp config/envs/commercial.example.env config/envs/commercial.env
#   ENVIRONMENT=commercial ./scripts/sso-login.sh --all
#   ENVIRONMENT=commercial ./scripts/run-all.sh apply --yes

PROJECT=inventory-sso
ENVIRONMENT=commercial
ROLE_NAME=r-edl-resource-inventory
ROLE_DESCRIPTION="Read-only Resource Groups and Resource Groups Tagging API access"
AWS_REGION=us-east-1
AWS_PARTITION=aws
PURPOSE=edl-resource-inventory
PROJECT_NAME_TAG=edl_resource_inventory
TAG_PROJECT_NAME=edl_resource_inventory
TAG_PROJECT_NUMBER=fs0000000001
TAG_ORGANIZATION=census:ocio:adsd
TAG_COST_ALLOCATION=adsd:edl
TAG_ENVIRONMENT=common
TAG_PROJECT_ROLE=edl_resource_inventory
TAG_EDL_PROJECT_ID=9999999
TAG_TITLE_DATA=title_13/title_26
TAG_BOC_CREATED_BY=terragrunt
RESOURCE_GROUP_ACCOUNT_ID=
PROFILE_PREFIX=
SSO_START_URL=
EXCLUDE_PROFILES=
