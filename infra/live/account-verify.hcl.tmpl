# Terragrunt live unit: data-only verify (no IAM writes).
# Generated by: ./scripts/stacks-generate.sh --mode verify
# Keep separate from create stacks so run-all state cannot destroy the role.
#
#   cd infra/live/verify-accounts
#   terragrunt run --all apply
#   terragrunt run --all output verification

include "root" {
  path   = find_in_parent_folders("root.hcl")
  expose = true
}

terraform {
  source = "${get_parent_terragrunt_dir()}/../modules/verify-role"
}

inputs = {
  aws_profile                = "{{profile}}"
  aws_region                 = "{{region}}"
  role_name                  = include.root.locals.role_name
  resource_group_account_id  = "{{resource_group_account_id}}"
  verification_dir           = get_terragrunt_dir()
  fail_if_not_compliant      = get_env("TG_FAIL_IF_NOT_COMPLIANT", "false") == "true"
}
