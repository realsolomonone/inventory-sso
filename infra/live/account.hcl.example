# Copy to infra/live/accounts/<profile>/terragrunt.hcl and set aws_profile.
# Then: cd infra/live/accounts && terragrunt run-all apply

include "root" {
  path = find_in_parent_folders("root.hcl")
}

inputs = {
  aws_profile               = "REPLACE_WITH_SSO_PROFILE"
  aws_region                = "us-gov-east-1"
  role_name                 = "r-edl-resource-inventory"
  resource_group_account_id = ""
  verification_dir          = get_terragrunt_dir()
  fail_if_not_compliant     = get_env("TG_FAIL_IF_NOT_COMPLIANT", "false") == "true"
}
