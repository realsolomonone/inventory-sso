# Copy to infra/live/accounts/<profile>/terragrunt.hcl, or run ./scripts/stacks-generate.sh
#
#   cd infra/live/accounts
#   terragrunt run --all apply

include "root" {
  path = find_in_parent_folders("root.hcl")
}

inputs = {
  aws_profile               = "REPLACE_WITH_SSO_PROFILE"
  verification_dir          = get_terragrunt_dir()
}
