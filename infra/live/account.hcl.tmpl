# Terragrunt live unit: create + verify the inventory IAM role in THIS account.
# Generated by ./scripts/stacks-generate.sh (one folder per SSO profile).
#
# All accounts (current Terragrunt CLI):
#   cd infra/live/accounts
#   terragrunt run --all plan
#   terragrunt run --all apply
#   terragrunt run --all output verification
#
# Older Terragrunt: terragrunt run-all plan
#
# One account:
#   cd infra/live/accounts/{{profile}}
#   terragrunt apply
#   terragrunt output verification

include "root" {
  path   = find_in_parent_folders("root.hcl")
  expose = true
}

inputs = {
  aws_profile                = "{{profile}}"
  aws_region                 = "{{region}}"
  role_name                  = include.root.locals.role_name
  role_description           = include.root.locals.role_description
  resource_group_account_id  = "{{resource_group_account_id}}"
  trusted_principal_arns     = include.root.locals.trusted_principal_arns
  trusted_source_account_ids = include.root.locals.trusted_source_account_ids
  tags                       = include.root.locals.common_tags
  verification_dir           = get_terragrunt_dir()
  fail_if_not_compliant      = get_env("TG_FAIL_IF_NOT_COMPLIANT", "false") == "true"
}
