# Terragrunt live unit: create + verify the inventory IAM role in THIS account.
# Generated by ./scripts/stacks-generate.sh (one folder per SSO profile).
#
# All accounts:
#   cd infra/live/accounts
#   terragrunt run --all plan
#   terragrunt run --all apply
#
# One account:
#   cd infra/live/accounts/{{profile}}
#   terragrunt apply

include "root" {
  path = find_in_parent_folders("root.hcl")
}

inputs = {
  aws_profile               = "{{profile}}"
  aws_region                = "{{region}}"
  resource_group_account_id = "{{resource_group_account_id}}"
  verification_dir          = get_terragrunt_dir()
}
