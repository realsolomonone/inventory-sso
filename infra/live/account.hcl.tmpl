# Per-account create + verify stack.
# Fill in by copying this file, or let `python edl_resource_inventory.py stacks generate` write one per SSO profile.

include "root" {
  path = find_in_parent_folders("root.hcl")
}

inputs = {
  aws_profile                = "{{profile}}"
  aws_region                 = "{{region}}"
  role_name                  = "{{role_name}}"
  resource_group_account_id  = "{{resource_group_account_id}}"
  trusted_principal_arns     = {{trusted_principal_arns}}
  trusted_source_account_ids = {{trusted_source_account_ids}}
  verification_dir           = get_terragrunt_dir()
  fail_if_not_compliant      = get_env("TG_FAIL_IF_NOT_COMPLIANT", "false") == "true"
}
